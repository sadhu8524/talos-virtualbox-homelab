cluster_name         = "homelab"
control_plane_name   = "talos-cp01"
control_plane_ip     = "192.168.56.10"
worker_names         = ["talos-worker01", "talos-worker02"]
worker_ips           = ["192.168.56.11", "192.168.56.12"]

vm_cpus              = 2
vm_memory_mb         = 4096
disk_size_mb         = 30720

host_only_adapter    = "VirtualBox Host-Only Ethernet Adapter"
host_only_gateway    = "192.168.56.1"
host_only_netmask    = "255.255.255.0"

talos_version        = "v1.14.1"
talos_iso_path       = ""
install_disk         = "/dev/sda"
auto_bootstrap       = true
